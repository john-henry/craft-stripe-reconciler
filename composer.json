{
  "name": "johnhenry/craft-stripe-reconciler",
  "description": "Finds Stripe payments that went through but never finished in Craft Commerce, checks them with Stripe and completes the orders.",
  "type": "craft-plugin",
  "version": "1.1.0",
  "keywords": [
    "craft-commerce",
    "stripe",
    "stripe payments",
    "payment reconciliation",
    "missing orders",
    "unpaid orders",
    "abandoned carts",
    "3d secure",
    "stripe webhooks",
    "double charge",
    "checkout recovery"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "John Henry",
      "homepage": "https://johnhenry.ie"
    }
  ],
  "homepage": "https://johnhenry.ie/plugins/stripe-reconciler/",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "craftcms/cms": "^5.0",
    "craftcms/commerce": "^5.0",
    "craftcms/commerce-stripe": "^5.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.2"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "johnhenry\\stripereconciler\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "support": {
    "docs": "https://johnhenry.ie/plugins/stripe-reconciler/",
    "source": "https://github.com/john-henry/craft-stripe-reconciler",
    "issues": "https://github.com/john-henry/craft-stripe-reconciler/issues"
  },
  "extra": {
    "name": "Stripe Reconciler",
    "handle": "stripe-reconciler",
    "developer": "John Henry",
    "developerUrl": "https://johnhenry.ie",
    "documentationUrl": "https://johnhenry.ie/plugins/stripe-reconciler/",
    "changelogUrl": "https://github.com/john-henry/craft-stripe-reconciler/blob/craft-5/CHANGELOG.md",
    "class": "johnhenry\\stripereconciler\\StripeReconciler"
  }
}
